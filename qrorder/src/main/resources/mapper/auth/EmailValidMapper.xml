<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="htms.QROrder.auth.repository.EmailValidMapper">

    <select id="userEmailMatchChk" resultType="boolean">
        select
            count(*) > 0
        from sys_user
        where 1=1
        and email = #{email}
        and user_id = #{userId}
    </select>

</mapper>