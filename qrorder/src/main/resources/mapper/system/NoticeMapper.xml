<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="htms.QROrder.system.repository.NoticeMapper">

    <resultMap id="noticeResultMap" type="htms.QROrder.system.domain.Notice">
        <result column="sys_id" property="sysId"/>
        <result column="notice_title" property="noticeTitle"/>
        <result column="notice_description" property="noticeDescription"/>
        <result column="start_date" property="startDate"/>
        <result column="use_yn" property="useYn"/>
    </resultMap>

    <select id="getOldData" resultMap="noticeResultMap">
        select
            sys_id,
            notice_title,
            notice_description,
            start_date,
            use_yn
        from sys_notice
        where sys_id = #{sysId}
        and delete_yn = 'N'
    </select>
</mapper>
